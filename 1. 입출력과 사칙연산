// 1-9
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int A,B,C;
	scanf("%d %d %d", &A,&B,&C);
	printf("%d\n", (A + B) % C);
	printf("%d\n", ((A % C) + (B % C)) % C);
	printf("%d\n", (A*B) % C);
	printf("%d\n", ((A % C) *(B % C)) % C);
	return 0;
}


// 1-10
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int a, b;
	scanf("%d", &a);
	scanf("%d", &b);

	int b1, b2, b3;
	b3 = b % 10;
	b2 = (b % 100 - b3) / 10;
	b1 = b / 100;

	int c, c1, c2, c3;
	c = a * b;
	c1 = b1 * a;
	c2 = b2 * a;
	c3 = b3 * a;
	printf("%d\n%d\n%d\n%d\n", c3, c2, c1, c);

	return 0;
}

