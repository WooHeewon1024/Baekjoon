#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	
	int n, m;
	scanf("%d %d", &n, &m);
	int a[200];
	for (int i = 0; i < n; i++) {
		a[i] = i+1;
	}
	for (int i = 0; i < m; i++) {
		int x, y;
		scanf("%d %d", &x, &y);
		int tmp = a[x - 1];
		a[x - 1] = a[y - 1];
		a[y - 1] = tmp;
	}
	for (int i = 0; i < n; i++) {
		printf("%d ", a[i]);
	}

	return 0;
}

