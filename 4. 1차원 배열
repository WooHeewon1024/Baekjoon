#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int n;
	int a[500];
	scanf("%d", &n);
	for (int i = 0; i < n; i++) {
		scanf("%d", &a[i]);
	}
	int k;
	scanf("%d", &k);
	int stack = 0;
	for (int i = 0; i < n; i++) {
		if (a[i] == k) {
			stack++;
		}
	}
	printf("%d", stack);


	return 0;
}


