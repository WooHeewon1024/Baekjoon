#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	
	int n;
	scanf("%d", &n);
	double a[2000];
	double max = 0;
	for (int i = 0; i < n; i++) {
		scanf("%lf", &a[i]);
		if (a[i] > max) {
			max = a[i];
		}
	}
	double total = 0;
	for (int i = 0; i < n; i++) {
		if (a[i] <= max) {
			a[i] = (a[i] / max) * 100;
		}
		total = total + a[i];
	}
	total = total / n;
	printf("%lf", total);



	return 0;
}



