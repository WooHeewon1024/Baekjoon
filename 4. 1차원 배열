// 4-8
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	
	int a[10];
	for (int i = 0; i < 10; i++) {
		scanf("%d", &a[i]);
		a[i] = a[i] % 42;
	}
	for (int i = 0; i < 10; i++) {
		for (int j = i+1; j < 10; j++) {
			if (a[i] == a[j]) {
				a[j] = 50;
			}
		}
	}
	int stack = 0;
	for (int i = 0; i < 10; i++) {
		if (a[i] < 42) {
			stack++;
		}
	}
	printf("%d", stack);

	return 0;
}

// 4-9
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	
	int n, m;
	scanf("%d %d", &n, &m);
	int a[200];
	for (int i = 0; i < n; i++) {
		a[i] = i + 1;
	}
	for (int i = 0; i < m; i++) {
		int x, y;
		scanf("%d %d", &x, &y);
		while (1) {
			if (x < y) {
				int tmp = a[x-1];
				a[x - 1] = a[y - 1];
				a[y - 1] = tmp;
			}
			else if (x >= y) {
				break;
			}
			x = x + 1;
			y = y - 1;
		}
	}
	for (int i = 0; i < n; i++) {
		printf("%d ", a[i]);
	}

	return 0;
}

