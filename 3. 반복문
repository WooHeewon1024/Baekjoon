// 3-9 (2438번) > 별 찍기 - 1
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int n;
	scanf("%d", &n);
	for (int i = 0; i < n; i++) {
		for (int j = 1; j <= i+1; j++) {
			printf("*");
		}
		printf("\n");
	}

	return 0;
}

// 3-10 (2439번) > 별 찍기 - 2
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int n;
	scanf("%d", &n);
	for (int i = n - 1; i >= 0; i--) {
		for (int j = 0; j < i; j++) {
			printf(" ");
		}
		for (int k= 0; k < n-i; k++) {
			printf("*");
		}
		printf("\n");
	}

	return 0;
}

