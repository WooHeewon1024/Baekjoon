// 3-4 (25304번) > 영수증
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int price;
	int n;
	int total=0;
	scanf("%d", &price);
	scanf("%d", &n);
	for (int i = 0; i < n; i++) {
		int a, b;
		scanf("%d %d", &a, &b);
		total = total + a * b;
	}
	if (price == total) {
		printf("Yes");
	}
	else {
		printf("No");
	}

	return 0;
}


