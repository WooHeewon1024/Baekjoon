#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#pragma warning(disable:4996)

int main() {
	int a, b, c;
	scanf("%d %d %d", &a, &b, &c);
	if (a == b && b == c) {
		printf("%d", a * 1000 + 10000);
	}

	else if (a == b && b != c) {
		printf("%d", a * 100 + 1000);
	}
	else if (a == c && a != b) {
		printf("%d", a * 100 + 1000);
	}
	else if (c == b && a != c) {
		printf("%d", c * 100 + 1000);
	}

	else if (a != b && b != c && a != c) {
		if (a > b && a > c) {
			printf("%d", a * 100);
		}
		else if (b > a && b > c) {
			printf("%d", b * 100);
		}
		else if (c > b && c > a) {
			printf("%d", c * 100);
		}
	}
	return 0;
}



